// Firebase Storage 보안 규칙 — hansol941201/card
// ─────────────────────────────────────────────────────────────────────────
// 이 파일은 이 저장소에 원래 없었습니다(§공통 발송자료 업로드 실패 조사 라운드에서
// 새로 작성). 실제 Firebase 콘솔에 이미 배포된 규칙이 이 파일과 다를 수 있습니다 —
// 이 파일 내용을 통째로 덮어쓰지 말고, 콘솔의 "Storage → Rules" 탭에서 기존 내용과
// 비교한 뒤 없는 부분(특히 mailCommonAssets 블록)만 추가해주세요. 통째로 덮어쓰면
// 여기서 다루지 않는 다른 경로에 대한 기존 규칙이 사라질 수 있습니다.
//
// 이 프로젝트는 팀 전체가 하나의 고정 Firebase 계정(로그인 이메일 1개, "사이트 잠금
// 비밀번호"로 로그인)을 공유합니다 — 그래서 uid도 사실상 팀 전체에 하나뿐입니다.
// 아래 규칙은 "로그인된 사람만 그 uid 경로에 접근 가능"을 보장할 뿐, 사람별로 접근을
// 나누지는 않습니다(이 앱의 기존 설계와 동일한 수준).
//
// 배포 방법: Firebase 콘솔 → Storage → Rules 탭에 아래 내용을 반영하고 게시(Publish).
// Firebase CLI가 있다면 firebase.json에 { "storage": { "rules": "storage.rules" } }를
// 추가한 뒤 `firebase deploy --only storage`로도 배포할 수 있습니다(이 저장소에는
// firebase.json이 없어 CLI 배포 설정은 별도로 준비해야 합니다).
//
// 절대 하지 말아야 할 것: `allow read, write: if true`(로그인 없이 전체 공개) 같은
// 규칙은 이 파일에도, 실제 콘솔에도 적용하지 마세요.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 기존: 업체별 서류함(사업자등록증·통장사본 등 민감 서류). saveDocumentFile이
    // 실제로 쓰는 경로와 정확히 같은 형태입니다 — 이 블록은 절대 완화하지 마세요.
    match /users/{userId}/customers/{companyId}/documents/{docId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 20 * 1024 * 1024; // DOC_MAX_CLOUD_BYTES(20MB)와 동일
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 신규: 공통 발송자료(메일 템플릿에 붙이는 문서/이미지/동영상 — 고객별 민감 서류와
    // 완전히 분리된 별도 경로). uploadMailAssetFile이 쓰는 경로와 정확히 같은 형태입니다.
    // 로그인한 사용자만 자신의(=이 프로젝트에서는 팀 공용) uid 경로에 읽기·쓰기·삭제할
    // 수 있고, 다른 uid 경로는 절대 접근할 수 없습니다. 최대 용량은 코드의
    // MAIL_ASSET_MAX_CLOUD_BYTES.video(100MB, 이 프로젝트에서 가장 큰 허용 용량)에 맞춰
    // 여유 있게 잡았습니다 — 문서/이미지는 코드에서 이미 더 작은 한도(20MB)로 먼저
    // 걸러집니다.
    match /users/{userId}/mailCommonAssets/{mailType}/{assetId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 100 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 그 외 모든 경로는 기본 거부 — 실제 배포 시에는 이 프로젝트에 이미 있는 다른
    // 허용 경로(있다면)를 이 fallback보다 위에 추가해주세요. 이 fallback 자체를
    // `if true`로 바꾸지 마세요.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
